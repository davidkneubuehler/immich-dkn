+import { modalManager, toastManager } from '@immich/ui';
+
+describe('AssetService', () => {
+  describe('getAssetBulkActions', () => {
+    beforeEach(() => {
+      authManager.setUser(factory.user());
+      vi.spyOn(modalManager, 'show').mockResolvedValue(undefined as never);
+      vi.spyOn(toastManager, 'danger').mockImplementation(() => undefined as never);
+    });
+
+    afterEach(() => {
+      vi.restoreAllMocks();
+    });
